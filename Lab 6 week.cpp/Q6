#include <iostream>
using namespace std;

class Student {
    float cgpa;

public:
    Student(float c) {
        cgpa = c;
    }

    bool operator==(Student s) {
        return cgpa == s.cgpa;
    }

    bool operator>(Student s) {
        return cgpa > s.cgpa;
    }
};

int main() {
    Student s1(8.5), s2(9.0);

    if (s1 == s2) {
        cout << "Both students have same CGPA." << endl;
    }
    else {
        cout << "Both students have different CGPA." << endl;
    }

    if (s1 > s2) {
        cout << "Student 1 has higher CGPA." << endl;
    }
    else if (s2 > s1) {
        cout << "Student 2 has higher CGPA." << endl;
    }
    else {
        cout << "Both students have same CGPA." << endl;
    }

    return 0;
}
