#include <iostream>
using namespace std;

class Number {
    int value;

public:
    Number(int v) {
        value = v;
    }

    Number operator+(Number n) {
        return Number(value + n.value);
    }

    void display() {
        cout << "Sum = " << value << endl;
    }
};

int main() {
    Number n1(20), n2(30);

    Number n3 = n1 + n2;

    n3.display();

    return 0;
}
