#include <iostream>
using namespace std;

class Maximum {
public:
    int findMax(int a, int b) {
        return (a > b) ? a : b;
    }
    int findMax(int a, int b, int c) {
        int max = a;
        if (b > max)
            max = b;
        if (c > max)
            max = c;
        return max;
    }
    double findMax(double a, double b) {
        return (a > b) ? a : b;
    }
};

int main() {
    Maximum obj;

    cout << "Maximum of two integers: "
         << obj.findMax(10, 20) << endl;

    cout << "Maximum of three integers: "
         << obj.findMax(10, 25, 15) << endl;

    cout << "Maximum of two decimal numbers: "
         << obj.findMax(12.5, 9.8) << endl;

    return 0;
}
