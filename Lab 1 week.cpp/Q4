#include <iostream>
#include <string>
using namespace std;
struct Student {
    string name;
    int rollNo;
    string degree;
    string hostel;
    double currentCGPA;

    void addDetails() {
        cout << "Enter Name: ";
        cin >> name;
        cout << "Enter Roll No: ";
        cin >> rollNo;
        cout << "Enter Degree: ";
        cin >> degree;
        cout << "Enter Hostel: ";
        cin >> hostel;
        cout << "Enter Current CGPA: ";
        cin >> currentCGPA;
    }

    void updateDetails() {
        cout << "\n--- Update All Details ---" << endl;
        cout << "Enter New Name: ";
        cin >> name;
        cout << "Enter New Roll No: ";
        cin >> rollNo;
        cout << "Enter New Degree: ";
        cin >> degree;
    }

    void updateCGPA() {
        cout << "\nEnter New CGPA: ";
        cin >> currentCGPA;
    }

    void updateHostel() {
        cout << "Enter New Hostel: ";
        cin >> hostel;
    }

    void displaydetails() {
        cout << "\n--- Student Details ---" << endl;
        cout << "Name: " << name << endl;
        cout << "Roll No: " << rollNo << endl;
        cout << "Degree: " << degree << endl;
        cout << "Hostel: " << hostel << endl;
        cout << "Current CGPA: " << currentCGPA << endl;
    }
};

int main() {
    Student s;
    s.addDetails();
    s.updateCGPA();
    s.updateHostel();
    s.updateDetails();
    s.displaydetails();

    return 0;
}
