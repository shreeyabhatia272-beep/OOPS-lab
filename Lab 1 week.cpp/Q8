#include <iostream>
using namespace std;

namespace First
{
    int x = 10;

    void display()
    {
        cout << "This is First namespace" << endl;
    }
}

namespace Second
{
    int x = 20;

    void display()
    {
        cout << "This is Second namespace" << endl;
    }
}

int main()
{
    cout << "Value of x in First namespace: " << First::x << endl;
    cout << "Value of x in Second namespace: " << Second::x << endl;

    First::display();
    Second::display();

    return 0;
}
