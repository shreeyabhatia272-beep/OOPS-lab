#include <iostream>
using namespace std;

class Number
{
private:
    int a, b;

public:
    void input()
    {
        cout << "Enter two numbers: ";
        cin >> a >> b;
    }

    friend void sum(Number n);
};

// Friend function
void sum(Number n)
{
    int result = n.a + n.b;

    cout << "Sum = " << result << endl;
}

int main()
{
    Number n;

    n.input();
    sum(n);

    return 0;
}
