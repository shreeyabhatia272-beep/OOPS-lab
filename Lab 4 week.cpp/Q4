#include <iostream>
#include <string>
using namespace std;

class Vehicle {
protected:
    string brand, model;
};
class Car : public Vehicle {
private:
    int doors;
public:
    void input() {
        cout << "Enter Car Brand: ";
        cin >> brand;
        cout << "Enter Car Model: ";
        cin >> model;
        cout << "Enter Number of Doors: ";
        cin >> doors;
    }
    void display() {
        cout << "Car: " << brand << " " << model << ", Doors: " << doors << endl;
    }
};

class Bike : public Vehicle {
private:
    int engineCapacity;
public:
    void input() {
        cout << "\nEnter Bike Brand: ";
        cin >> brand;
        cout << "Enter Bike Model: ";
        cin >> model;
        cout << "Enter Engine Capacity (cc): ";
        cin >> engineCapacity;
    }
    void display() {
        cout << "Bike: " << brand << " " << model << ", Engine: " << engineCapacity << " cc" << endl; 
    }
};

int main() {
    Car c; 
    Bike b;    
    c.input(); 
    b.input();    
    cout << "\n--- Vehicle Details ---" << endl;
    c.display(); 
    b.display();
    
    return 0;
}
