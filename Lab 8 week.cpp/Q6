#include <iostream>
using namespace std;

class Student {
    int marks[5];

public:
    void inputMarks() {
        for (int i = 0; i < 5; i++) {
            cout << "Enter marks of subject " << i + 1 << ": ";
            cin >> marks[i];

            if (marks[i] < 0 || marks[i] > 100) {
                throw marks[i];
            }
        }
    }

    void calculateAverage() {
        int sum = 0;

        for (int i = 0; i < 5; i++) {
            sum = sum + marks[i];
        }

        cout << "Average marks = " << sum / 5.0 << endl;
    }
};

int main() {
    Student s;

    try {
        s.inputMarks();
        s.calculateAverage();
    }
    catch (int x) {
        cout << "Error: Invalid marks " << x
             << ". Marks must be between 0 and 100.";
    }

    return 0;
}
