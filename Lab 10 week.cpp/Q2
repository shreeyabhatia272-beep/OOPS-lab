#include <iostream>
#include <list>
using namespace std;

int main()
{
    list<int> l;

    l.push_back(20);
    l.push_back(30);
    l.push_front(10);

    cout << "Original List: ";

    for(int x : l)
        cout << x << " ";

    l.pop_back();

    cout << "\nAfter removing last element: ";

    for(int x : l)
        cout << x << " ";

    return 0;
}
